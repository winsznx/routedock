
# Stellar network — testnet (default) or mainnet
STELLAR_NETWORK=testnet

# Agent Stellar keypair — must have testnet USDC balance
# Fund via Friendbot: https://friendbot.stellar.org?addr=G...
# Then manually add USDC trustline and fund from testnet faucet
AGENT_SECRET=S...

# Ed25519 commitment secret for MPP sessions (required for openSession)
# Provider-b's COMMITMENT_PUBLIC_KEY must be the public key of this secret
COMMITMENT_SECRET=S...

# Optional: custom path to store local daily spend accumulator (defaults to ~/.routedock/spend.json)
# AGENT_SPEND_STORE_PATH=

# Optional: if using the AgentVault contract account instead of a plain keypair (unused by agent run)
# AGENT_VAULT_CONTRACT_ID=CAX5IDLC2XHGQSEA2YN3LPLZ7EXLMRXYX3HFJGKFXS6B7OQXBKWO44LT

# Local daily spend cap for policy rejection demo
# Must be > x402_price (0.001) + mpp_charge_price (0.0008) + (50 x session rate (0.0001) = 0.005) = 0.0068
# and < 0.0068 + x402_price (0.001) = 0.0078  → policy fires on step 5
AGENT_DAILY_CAP_USDC=0.007

# Provider URLs — use deployed Worker URLs (https://api-a.routedock.xyz, https://api-b.routedock.xyz) or local dev servers
PROVIDER_A_URL=http://localhost:3001
PROVIDER_B_URL=http://localhost:3002

# Supabase (optional / unused by agent run; only recover-sessions reads SUPABASE_URL with SUPABASE_SERVICE_KEY)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJ...
