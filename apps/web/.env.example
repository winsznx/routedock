# cp .env.example .env.local

# Public testnet Supabase project used by the RouteDock dashboard. These are
# the same values committed at apps/web/wrangler.jsonc, and the anon key is a
# public client key safe to check in — copying this file gives a working
# dashboard with no further setup.
NEXT_PUBLIC_SUPABASE_URL=https://druyoubnnrjkbzqyvkni.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_ANON_KEY

NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Only affects metadata URLs (e.g. Open Graph). Defaults to
# https://www.routedock.xyz when unset.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
