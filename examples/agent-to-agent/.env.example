# Copy this file to .env and fill in funded Stellar testnet secrets.
#
# ORCHESTRATOR_SECRET is the orchestrator agent's Stellar keypair (payer).
ORCHESTRATOR_SECRET=S...

# SPECIALIST_SECRET is the specialist sub-agent's Stellar keypair (receiver).
# Required when START_MOCK_SPECIALIST=true.
SPECIALIST_SECRET=S...

# SPECIALIST_URL is the specialist sub-agent's public endpoint.
SPECIALIST_URL=http://localhost:3200

# Whether to start the mock specialist server in-process.
START_MOCK_SPECIALIST=true

# RouteDock network for both agents.
STELLAR_NETWORK=testnet

# Optional: USDC asset contract override (defaults to testnet USDC on testnet).
# USDC_ASSET_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
