{
  "name": "@routedock/nulth-sdk",
  "version": "0.2.2",
  "description": "Off-chain ZK proof builder for Nulth smart accounts on Stellar",
  "license": "MIT",
  "homepage": "https://github.com/winsznx/routedock/tree/main/packages/nulth-sdk#readme",
  "bugs": {
    "url": "https://github.com/winsznx/routedock/issues"
  },
  "publishConfig": {
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/winsznx/routedock.git",
    "directory": "packages/nulth-sdk"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/__tests__/*.test.ts",
    "check:readme": "node ../../scripts/check-nulth-readme.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@stellar/stellar-sdk": "^14.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "stellar",
    "soroban",
    "usdc",
    "x402",
    "mpp",
    "payments",
    "ai-agents",
    "zk"
  ]
}
